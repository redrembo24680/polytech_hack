# Скопіюйте в .env і заповніть. Ключ: https://aistudio.google.com
GEMINI_API_KEY=

# Провайдер: gemini (за замовчуванням) або fake (офлайн-демо без мережі)
# AGENT_PROVIDER=gemini

# Модель. За замовчуванням gemma-4-31b-it; запасні: gemma-4-26b-a4b-it, gemini-2.5-flash
# AGENT_MODEL=gemma-4-31b-it

# 1 = системний промпт префіксом у першому повідомленні (якщо модель ігнорує system_instruction)
# Спробувати першим, якщо Gemma не викликає tools
# AGENT_SYSTEM_AS_PREFIX=1

# Локальна модель через Ollama (або будь-який OpenAI-сумісний сервер), без ключа Gemini:
# AGENT_PROVIDER=ollama
# AGENT_MODEL=gemma4
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama

# Claude через Anthropic API (за замовчуванням модель claude-sonnet-5-5):
# AGENT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5-5   # за потреби: claude-opus-5-5

# Майбутнє: підключення до апки тіммейта (у коді ще не читається)
# APP_API_URL=http://localhost:8001
# APP_MCP_URL=http://localhost:8001/mcp
